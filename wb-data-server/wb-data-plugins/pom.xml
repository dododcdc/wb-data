<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.wbdata</groupId>
        <artifactId>wb-data-parent</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>wb-data-plugins</artifactId>
    <name>wb-data-plugins</name>
    <packaging>pom</packaging>

    <modules>
        <module>wb-data-plugin-mysql</module>
        <module>wb-data-plugin-hive</module>
        <module>wb-data-plugin-postgresql</module>
        <module>wb-data-plugin-clickhouse</module>
    </modules>

    <dependencies>
        <dependency>
            <groupId>com.wbdata</groupId>
            <artifactId>wb-data-plugin-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-antrun-plugin</artifactId>
                    <executions>
                        <execution>
                            <id>sync-plugin-jar</id>
                            <phase>package</phase>
                            <goals>
                                <goal>run</goal>
                            </goals>
                            <configuration>
                                <target>
                                    <mkdir dir="${project.basedir}/../../../plugins" />
                                    <copy file="${project.build.directory}/${project.artifactId}-${project.version}-plugin.jar"
                                          todir="${project.basedir}/../../../plugins"
                                          overwrite="true" />
                                </target>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
