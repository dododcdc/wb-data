<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.wbdata</groupId>
        <artifactId>wb-data-parent</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>wb-data-kestra-plugin</artifactId>
    <name>wb-data-kestra-plugin</name>
    <description>WB-Data SQL-aware JDBC query tasks for Kestra</description>

    <properties>
        <kestra.version>1.3.0</kestra.version>
        <kestra.jdbc.version>1.9.2</kestra.jdbc.version>
        <lombok.version>1.18.38</lombok.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.kestra</groupId>
                <artifactId>platform</artifactId>
                <version>${kestra.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>com.wbdata</groupId>
            <artifactId>wb-data-sql-template</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.kestra.plugin</groupId>
            <artifactId>plugin-jdbc-mysql</artifactId>
            <version>${kestra.jdbc.version}</version>
            <exclusions>
                <exclusion>
                    <groupId>io.kestra.plugin</groupId>
                    <artifactId>plugin-jdbc</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>com.mysql</groupId>
                    <artifactId>mysql-connector-j</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>io.kestra.plugin</groupId>
            <artifactId>plugin-jdbc-postgres</artifactId>
            <version>${kestra.jdbc.version}</version>
            <exclusions>
                <exclusion>
                    <groupId>io.kestra.plugin</groupId>
                    <artifactId>plugin-jdbc</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.postgresql</groupId>
                    <artifactId>postgresql</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.bouncycastle</groupId>
                    <artifactId>bcprov-jdk18on</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.bouncycastle</groupId>
                    <artifactId>bcpkix-jdk18on</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>io.kestra</groupId>
            <artifactId>core</artifactId>
            <version>${kestra.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${lombok.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.10.2</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>3.24.2</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <version>5.11.0</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                        <path>
                            <groupId>io.kestra</groupId>
                            <artifactId>processor</artifactId>
                            <version>${kestra.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.2</version>
                <configuration>
                    <archive>
                        <manifestEntries>
                            <X-Kestra-Name>${project.artifactId}</X-Kestra-Name>
                            <X-Kestra-Title>WB-Data JDBC</X-Kestra-Title>
                            <X-Kestra-Group>io.wbdata.kestra.jdbc</X-Kestra-Group>
                            <X-Kestra-Description>${project.description}</X-Kestra-Description>
                            <X-Kestra-Version>${project.version}</X-Kestra-Version>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <configuration>
                    <filters combine.children="append">
                        <filter>
                            <artifact>io.kestra.plugin:*</artifact>
                            <excludes>
                                <exclude>META-INF/services/io.kestra.core.models.Plugin</exclude>
                            </excludes>
                        </filter>
                    </filters>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>
        </plugins>
    </build>
</project>
